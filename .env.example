# Host development (npm run dev:api)
PORT=4000
DATABASE_URL=postgresql://brewlite:replace_with_url_safe_password@localhost:5433/brewlite?schema=public

# Docker Compose (POSTGRES_PASSWORD should be URL-safe or percent-encoded in DATABASE_URL).
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=
POSTGRES_DB=brewlite
POSTGRES_HOST_PORT=5433
API_HOST_PORT=4000
WEB_HOST_PORT=3000

# Authentication: use a random 32+-byte secret; do not commit .env.
JWT_SECRET=

# Browser-facing API URL, embedded into web build.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Payment: mock-only in this deployment stage.
PAYMENT_MODE=mock

# Only for the local Mock Payment test UI. Never enable with real payments.
NEXT_PUBLIC_MOCK_PAYMENT_TEST_CONTROLS=false

# Docker website reads catalog and product details from the API.
NEXT_PUBLIC_MENU_DATA_SOURCE=api
NEXT_PUBLIC_PRODUCT_DETAIL_ENABLED=true
