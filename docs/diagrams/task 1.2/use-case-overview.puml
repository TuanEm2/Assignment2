@startuml system-use-case-overview
!theme plain
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam dpi 200

skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #1E293B
  FontStyle bold
}

skinparam usecase {
  BackgroundColor #FFFBEB
  BorderColor #D97706
  FontColor #451A03
  ArrowColor #78350F
}

skinparam actor {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #1E3A8A
}

title **SƠ ĐỒ USE CASE TỔNG QUÁT HỆ THỐNG BREWLITE** (Task 1.2 - Ân Trần)

left to right direction

actor "Khách hàng\n(Customer)" as Customer
actor "Nhân viên / Quản lý\n(Staff / Admin)" as Staff
actor "Cổng thanh toán\nmô phỏng (Mock Gateway)" as PaymentGateway

rectangle "Hệ thống Đặt đồ uống BrewLite" {

  package "1. Xác thực & Tài khoản" {
    usecase "Đăng ký tài khoản" as UC_Register
    usecase "Đăng nhập hệ thống" as UC_Login
    usecase "Quản lý phiên (JWT Bearer)" as UC_Auth
  }

  package "2. Thực đơn & Tùy chọn món" {
    usecase "Xem thực đơn (Menu)" as UC_ViewMenu
    usecase "Tìm kiếm & Lọc sản phẩm" as UC_SearchFilter
    usecase "Xem chi tiết đồ uống" as UC_ViewDetail
    usecase "Tùy chỉnh Size & Topping" as UC_Customize
  }

  package "3. Giỏ hàng & Tạo đơn" {
    usecase "Quản lý giỏ hàng\n(Thêm / Sửa / Xóa món)" as UC_ManageCart
    usecase "Đặt đơn hàng (Checkout)" as UC_Checkout
    usecase "Kiểm tra & Giữ kho nguyên liệu" as UC_ReserveInventory
  }

  package "4. Thanh toán (Payment)" {
    usecase "Thanh toán đơn hàng" as UC_Payment
    usecase "Thanh toán bằng Ví mô phỏng" as UC_Wallet
    usecase "Thanh toán bằng Thẻ mô phỏng" as UC_Card
    usecase "Thử thanh toán lại (Retry)" as UC_RetryPayment
    usecase "Kiểm tra trạng thái thanh toán" as UC_CheckPaymentStatus
  }

  package "5. Lịch sử & Vận hành đơn" {
    usecase "Xem lịch sử đơn hàng" as UC_ViewOrders
    usecase "Xem chi tiết đơn hàng (Snapshot)" as UC_OrderDetail
    usecase "Cập nhật tiến độ đơn\n(Pha chế -> Sẵn sàng -> Hoàn thành)" as UC_UpdateStatus
    usecase "Quản lý tồn kho nguyên liệu" as UC_ManageStock
  }
}

' Khách hàng tương tác
Customer --> UC_Register
Customer --> UC_Login
Customer --> UC_ViewMenu
Customer --> UC_SearchFilter
Customer --> UC_ViewDetail
Customer --> UC_ManageCart
Customer --> UC_Checkout
Customer --> UC_ViewOrders
Customer --> UC_OrderDetail

' Mối quan hệ giữa các Use Case
UC_ViewDetail ..> UC_Customize : <<include>>
UC_Customize ..> UC_ManageCart : <<extend>>

UC_Checkout ..> UC_Auth : <<include>>
UC_Checkout ..> UC_ReserveInventory : <<include>>
UC_Checkout ..> UC_Payment : <<include>>

UC_Payment <|-- UC_Wallet : <<generalize>>
UC_Payment <|-- UC_Card : <<generalize>>
UC_RetryPayment ..> UC_Payment : <<extend>>\n[lần thử trước thất bại]
UC_CheckPaymentStatus ..> UC_Payment : <<extend>>\n[mất mạng chưa rõ kết quả]

UC_OrderDetail ..> UC_Auth : <<include>>
UC_ViewOrders ..> UC_Auth : <<include>>

' Nhân viên tương tác
Staff --> UC_UpdateStatus
Staff --> UC_ManageStock

' Cổng thanh toán ngoài tương tác
PaymentGateway -- UC_Payment
PaymentGateway -- UC_CheckPaymentStatus

@enduml
